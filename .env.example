# Copy to .env.local and fill in. Without a project ID the site runs on placeholder content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Optional: an Editor token (sanity.io/manage → API → Tokens) so the enquiry form saves to Sanity.
SANITY_API_WRITE_TOKEN=

# Used for canonical URLs and social share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
